DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
TIME_ZONE=Europe/Berlin
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DATABASE_URL=sqlite:///db.sqlite3
# Use one URL for most setups:
CSRF_TRUSTED_ORIGIN=
# Or multiple (comma or newline separated):
CSRF_TRUSTED_ORIGINS=
USE_SECURE_COOKIES=false
SECURE_SSL_REDIRECT=false

ADMIN_USERNAME=change-admin-username
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-admin-password

TEST_USERNAME=change-test-username
TEST_EMAIL=your-test-user@example.com
TEST_PASSWORD=change-test-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=notifications@example.com

RAG_ENABLE_LOCAL_MODEL=true
RAG_MODEL_NAME=google/flan-t5-small
